rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function validProfile(data) {
      return data.keys().hasAll(['email', 'firstName', 'lastName', 'gender', 'mobile', 'address', 'preferences', 'favoriteBook', 'acceptedTermsVersion', 'acceptedTermsAt'])
        && data.keys().hasOnly(['email', 'firstName', 'lastName', 'gender', 'mobile', 'address', 'preferences', 'favoriteBook', 'acceptedTermsVersion', 'acceptedTermsAt'])
        && data.email == request.auth.token.email.lower()
        && text(data.firstName, 1, 100) && data.firstName.matches('.*[^ ].*')
        && text(data.lastName, 1, 100) && data.lastName.matches('.*[^ ].*')
        && data.gender in ['Woman', 'Man', 'Non-binary', 'Self-described / other', 'Prefer not to say']
        && text(data.mobile, 10, 32) && data.mobile.matches('[+]?([ ()-]*[0-9]){10,15}[ ()-]*')
        && text(data.address, 1, 200) && data.address.matches('.*[^ ].*')
        && data.preferences is list && data.preferences.size() > 0 && data.preferences.size() <= 12
        && data.preferences.hasOnly(['Fiction', 'Mystery', 'Fantasy', 'Science fiction', 'Romance', 'History', 'Biography', 'Self-development', 'Science & technology', 'Academic', 'Poetry', 'Other'])
        && text(data.favoriteBook, 0, 200)
        && data.acceptedTermsVersion == '1.1'
        && data.acceptedTermsAt == request.time;
    }
    match /profiles/{uid} {
      // Pending accounts can finish registration and read only their own profile.
      allow get: if owns(uid);
      allow create: if owns(uid) && validProfile(request.resource.data);
      allow list, update, delete: if false;
    }
    function validPublicProfile(data) {
      return data.keys().hasOnly(['firstName'])
        && text(data.firstName, 1, 100);
    }
    // Deliberately separate from /profiles: this is the only piece of another
    // member's identity anyone can read before a borrow request is accepted —
    // no contact info (mobile/email/address) ever lives here.
    match /public_profiles/{uid} {
      allow get: if member();
      allow create: if owns(uid) && validPublicProfile(request.resource.data);
      allow list, update, delete: if false;
    }
    function validBook(data, bookId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'author', 'genre', 'condition', 'estimatedValue', 'description', 'coverPhotoUrl', 'isbn', 'workKey', 'status', 'updatedAtMs'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'author', 'genre', 'condition', 'estimatedValue', 'description', 'coverPhotoUrl', 'isbn', 'workKey', 'status', 'updatedAtMs'])
        && data.id == bookId
        && data.ownerId == request.auth.uid
        && text(data.title, 1, 300) && data.title.matches('.*[^ ].*')
        && text(data.author, 0, 300)
        && text(data.genre, 0, 300)
        && text(data.condition, 1, 50)
        && data.estimatedValue is number && data.estimatedValue >= 0
        && text(data.description, 0, 2000)
        && (data.coverPhotoUrl == null || data.coverPhotoUrl is string)
        && (data.isbn == null || data.isbn is string)
        && (data.workKey == null || data.workKey is string)
        && data.status in ['available', 'requested', 'lent', 'returned']
        && data.updatedAtMs is number;
    }
    // Membership is derived from a validated profile AND a verified Firebase token.
    // Use member() for future member-only collections as well.
    match /books/{bookId} {
      allow read: if member();
      allow create, update: if member() && validBook(request.resource.data, bookId);
      allow delete: if member() && resource.data.ownerId == request.auth.uid;
    }
    // Only the fields a request can never sensibly be without are in hasAll;
    // every field that started out optional (or was added to the schema
    // after some documents already existed) is checked via .get(field, null)
    // instead of dot access or hasAll. A partial .update() only patches the
    // keys it names — on a document that predates a later field, the merged
    // request.resource.data can still be missing that key entirely, and
    // dot-accessing (or requiring via hasAll) a genuinely missing map key is
    // a rules evaluation error, which denies the whole write.
    function validRequest(data, requestId) {
      return data.keys().hasAll(['id', 'bookId', 'bookTitle', 'borrowerId', 'lenderId', 'status', 'requestedAt'])
        && data.keys().hasOnly(['id', 'bookId', 'bookTitle', 'bookCoverUrl', 'borrowerId', 'lenderId', 'status', 'requestedAt', 'respondedAt', 'expectedReturnDateMs', 'borrowerContact', 'lenderContact', 'returnedAt', 'proposedReturnDateMs'])
        && data.id == requestId
        && text(data.bookId, 1, 200)
        && text(data.bookTitle, 1, 300)
        && (data.get('bookCoverUrl', null) == null || data.get('bookCoverUrl', null) is string)
        && text(data.borrowerId, 1, 200)
        && text(data.lenderId, 1, 200)
        && data.borrowerId != data.lenderId
        && data.status in ['pending', 'accepted', 'declined']
        && data.requestedAt is number
        && (data.get('respondedAt', null) == null || data.get('respondedAt', null) is number)
        && (data.get('expectedReturnDateMs', null) == null || data.get('expectedReturnDateMs', null) is number)
        && (data.get('borrowerContact', null) == null || text(data.get('borrowerContact', null), 1, 32))
        && (data.get('lenderContact', null) == null || text(data.get('lenderContact', null), 1, 32))
        && (data.get('returnedAt', null) == null || data.get('returnedAt', null) is number)
        && (data.get('proposedReturnDateMs', null) == null || data.get('proposedReturnDateMs', null) is number);
    }
    // Contact fields (borrowerContact/lenderContact) are deliberately absent
    // until each party explicitly reveals theirs — never both at creation.
    // See BorrowRequest/FirestoreRequestRepository for the write choreography
    // this enforces: only the lender may accept/decline, only the borrower
    // may publish their own contact, and only after acceptance.
    match /requests/{requestId} {
      allow read: if member()
        && (resource.data.borrowerId == request.auth.uid
            || resource.data.lenderId == request.auth.uid);
      allow create: if member()
        && validRequest(request.resource.data, requestId)
        && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.respondedAt == null
        && request.resource.data.expectedReturnDateMs == null
        && request.resource.data.borrowerContact == null
        && request.resource.data.lenderContact == null
        && request.resource.data.returnedAt == null
        && request.resource.data.proposedReturnDateMs == null
        // SRS §3.4: prevent a blocked user from sending new requests to the
        // user who blocked them. exists() works without a read grant on
        // /blocks, which is what makes this enforceable without exposing
        // the borrower's own read access to the lender's block list.
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.lenderId + '_' + request.resource.data.borrowerId));
      allow update: if member() && validRequest(request.resource.data, requestId) && (
        (resource.data.lenderId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.borrowerId == resource.data.borrowerId
          && request.resource.data.lenderId == resource.data.lenderId
          && request.resource.data.bookId == resource.data.bookId
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt', 'expectedReturnDateMs', 'lenderContact']))
        ||
        (resource.data.borrowerId == request.auth.uid
          && resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['borrowerContact']))
        ||
        // Loan Lifecycle (SRS §3.5): lender-only, marks an active loan as
        // returned. Trimmed from the spec's "either party" — only the
        // lender's client can write the corresponding book status change
        // (books/{bookId} rules require ownerId == auth.uid), so having the
        // borrower separately flag a return here would just be inert state
        // with no matching book-status effect.
        (resource.data.lenderId == request.auth.uid
          && resource.data.status == 'accepted'
          && resource.data.get('returnedAt', null) == null
          && request.resource.data.status == 'accepted'
          && request.resource.data.returnedAt is number
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['returnedAt']))
        ||
        // Loan extensions (SRS §3.5): borrower proposes a new return date on
        // an active loan (one pending proposal at a time)...
        // resource.data.get(...) rather than dot access: a request document
        // written before these fields existed in the schema has no such key
        // at all, and dot-accessing a genuinely missing map key is a rules
        // evaluation error (denies the whole request), not just falsy.
        (resource.data.borrowerId == request.auth.uid
          && resource.data.status == 'accepted'
          && resource.data.get('returnedAt', null) == null
          && resource.data.get('proposedReturnDateMs', null) == null
          && request.resource.data.proposedReturnDateMs is number
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['proposedReturnDateMs']))
        ||
        // ...and the lender either approves it (moving the proposal into
        // expectedReturnDateMs) or declines it (clearing it, return date
        // untouched) — both just clear proposedReturnDateMs, so the two
        // outcomes are distinguished by whether expectedReturnDateMs moved.
        (resource.data.lenderId == request.auth.uid
          && resource.data.status == 'accepted'
          && resource.data.get('proposedReturnDateMs', null) != null
          && request.resource.data.proposedReturnDateMs == null
          && (
            (request.resource.data.expectedReturnDateMs == resource.data.expectedReturnDateMs
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['proposedReturnDateMs']))
            ||
            (request.resource.data.expectedReturnDateMs == resource.data.proposedReturnDateMs
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['proposedReturnDateMs', 'expectedReturnDateMs']))
          ))
      );
      allow delete: if false;
    }
    function validWantedBook(data, wantedId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'author', 'coverUrl', 'workKey', 'matchKey', 'addedAtMs'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'author', 'coverUrl', 'workKey', 'matchKey', 'addedAtMs'])
        && data.id == wantedId
        && data.userId == request.auth.uid
        && text(data.title, 1, 300)
        && text(data.author, 0, 300)
        && (data.coverUrl == null || data.coverUrl is string)
        && (data.workKey == null || data.workKey is string)
        && text(data.matchKey, 1, 300)
        && data.addedAtMs is number;
    }
    // Member-readable like /books: every wishlist entry is visible to every
    // member, deliberately, because mutual-swap detection (SRS §3.5) runs
    // entirely on-device from these two collections — there's no backend
    // function to do the matching centrally. A wanted title carries none of
    // the contact/location sensitivity that gates /requests.
    match /wanted_books/{wantedId} {
      allow read: if member();
      allow create: if member() && validWantedBook(request.resource.data, wantedId);
      allow update: if false;
      allow delete: if member() && resource.data.userId == request.auth.uid;
    }
    function validBlock(data, blockId) {
      return data.keys().hasAll(['id', 'blockerId', 'blockedId', 'blockedName', 'createdAtMs'])
        && data.keys().hasOnly(['id', 'blockerId', 'blockedId', 'blockedName', 'createdAtMs'])
        && data.id == blockId
        && data.id == data.blockerId + '_' + data.blockedId
        && data.blockerId == request.auth.uid
        && text(data.blockedId, 1, 200)
        && data.blockerId != data.blockedId
        && text(data.blockedName, 1, 200)
        && data.createdAtMs is number;
    }
    // Deliberately NOT member-readable like /books or /wanted_books — who
    // you've blocked is private to you. The doc id is the composite
    // '{blockerId}_{blockedId}' precisely so /requests' create rule can do a
    // targeted exists() check (below) without needing read access here:
    // exists() evaluates independently of read rules.
    match /blocks/{blockId} {
      allow read: if member() && resource.data.blockerId == request.auth.uid;
      allow create: if member() && validBlock(request.resource.data, blockId);
      allow update: if false;
      allow delete: if member() && resource.data.blockerId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
